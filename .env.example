# Copy to .env for a local run; on a server set these as environment variables (Secret Manager).
# Never commit the real .env.

# SCM MySQL (cp_database_N)
SCM_DB_HOST=
SCM_DB_PORT=3306
SCM_DB_USER=
SCM_DB_PASSWORD=
SCM_DB_NAME=scm

# Delivery Note (ERP) MySQL - joined onto the RTO rows for the ERP status / net value
DN_DB_HOST=
DN_DB_PORT=3306
DN_DB_USER=
DN_DB_PASSWORD=
DN_DB_NAME=

# Google Sheet the entries are appended to, and the Drive folders for POD / video uploads
GOOGLE_SHEET_ID=
# Optional: sheet tab to write to. Leave blank to use the first tab.
GOOGLE_SHEET_TAB=
DRIVE_POD_FOLDER_ID=
DRIVE_VIDEO_FOLDER_ID=
# Optional: path of the service account key (default: service_account.json next to main.py)
GOOGLE_SERVICE_ACCOUNT_FILE=

# On a server: the IAP audience of the service. Blank = local run, answers this machine only.
IAP_AUDIENCE=
# Who may sign in through IAP (comma-separated domains)
ALLOWED_EMAIL_DOMAINS=supertails.com

# Daily refresh from the databases, HH:MM India time
DAILY_REFRESH_AT=09:00
