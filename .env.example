# Copy to .env for a local run; on a server set these as environment variables (Secret Manager).
# Never commit the real .env.

# SCM MySQL (cp_database_N)
SCM_DB_HOST=
SCM_DB_PORT=3306
SCM_DB_USER=
SCM_DB_PASSWORD=
SCM_DB_NAME=scm

# Delivery Note (ERP) MySQL - joined onto the RTO rows for the ERP status / net value
DN_DB_HOST=
DN_DB_PORT=3306
DN_DB_USER=
DN_DB_PASSWORD=
DN_DB_NAME=

# Google Sheet the entries are appended to, and the Drive folders for POD / video uploads
GOOGLE_SHEET_ID=
# Optional: sheet tab to write to. Leave blank to use the first tab.
GOOGLE_SHEET_TAB=
DRIVE_POD_FOLDER_ID=
DRIVE_VIDEO_FOLDER_ID=
# Optional: path of the service account key (default: service_account.json next to main.py)
GOOGLE_SERVICE_ACCOUNT_FILE=

# On a server: the IAP audience of the service. Blank = local run, answers this machine only.
IAP_AUDIENCE=
# On a server not behind IAP yet: 1 = anyone can reach the sign-in page, and the panel's own
# sign-in (warehouse_users) is the only lock. Ignored when IAP_AUDIENCE is set.
ALLOW_WITHOUT_IAP=
# Who may sign in through IAP (comma-separated domains)
ALLOWED_EMAIL_DOMAINS=supertails.com

# Signs the session cookie of the panel's own sign-in (auth.py; users in scm.warehouse_users).
# On a server, set it (the same value on every instance), or everyone is signed out on each restart.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Usernames (comma-separated, exactly as in scm.warehouse_users) who are always admins: they manage
# everyone's role and tabs on the Users page, whatever scm.warehouse_user_access says (users.py).
ADMIN_USERS=

# Daily refresh from the databases, HH:MM India time
DAILY_REFRESH_AT=09:00
