# Same exclusions as .dockerignore, for `gcloud run deploy --source` / `gcloud builds submit`.
.gcloudignore
.gitignore
# Never ship secrets or local data in an image: on a server, DB passwords come from Secret Manager
# and Google access from the runtime service account, not from these files.
.env
.env.*
service_account.json
credentials.json
token.json
secrets/
*.db
*.db-journal
*_cache.json
breach_pipeline/data/
breach_cache/
dropdown_cache.csv
control_tower_cache.json*
Control Tower.xlsx
*.tmp
.cache/

# Not part of the app
analytics-scripts/
archive/
tests/
*.pdf
*.zip
.git/
.pytest_cache/
__pycache__/
*.pyc
.DS_Store
